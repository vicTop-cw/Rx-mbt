import {
  "vicTop-cw/RX-MBT/monitor",
  "vicTop-cw/RX-MBT/rx",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/hashset",
  "moonbitlang/core/ref",
  "moonbitlang/core/debug",
  "moonbitlang/core/async",
}

options(
  targets: {
    "rhop_js.mbt": [ "js" ],
    "rhop_native.mbt": [ "native" ],
    "rhop_fs_types.mbt": [ "js", "native", "wasm" ],
    "rhop_native_wbtest.mbt": [ "native" ],
    "rhop_fs_native.mbt": [ "native", "wasm" ],
  },
  "native-stub": [ "rhop_fs_native_stubs.c" ],
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)
